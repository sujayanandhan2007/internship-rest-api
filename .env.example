PORT=3000
NODE_ENV=development
DB_PATH=./data/internships.db
BODY_LIMIT=10kb
# Application submissions: max requests per window per IP (window in ms)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000
# Set to the number of reverse proxies in front of the app (e.g. 1 on Render/Heroku). Leave unset locally.
# TRUST_PROXY=1
