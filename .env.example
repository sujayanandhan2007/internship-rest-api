# Copy to .env for local use. Never commit .env or real secrets.
PORT=3000
NODE_ENV=development
DB_PATH=./data/internships.db
BODY_LIMIT=10kb
# Application submissions: max requests per window per IP (window in ms)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000
# Set to the number of reverse proxies in front of the app (1 on Render). Leave unset locally.
# TRUST_PROXY=1
# Protects POST/PUT/DELETE /api/internships (send as header X-Admin-Key).
# Unset in production = those writes are disabled (403). Unset in development = open.
# Generate a long random value; do not reuse passwords.
# ADMIN_API_KEY=
